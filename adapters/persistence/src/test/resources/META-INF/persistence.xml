<?xml version="1.0" encoding="UTF-8"?>
<!--
  JSR 338 (Jakarta Persistence) descriptor for AbstractJpaRepositoryTest's throwaway test entity.
  Mirrors the shape of the real adapters' persistence.xml (RESOURCE_LOCAL transaction type,
  hibernate.hbm2ddl.auto=validate, exactly one <class> line): this persistence unit is test-only
  scaffolding used to prove the shared AbstractJpaRepository lifecycle in isolation, never wired
  into any real adapter and never referencing ChallengeTierEntity or its persistence unit.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="abstract-jpa-repository-test" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>net.onelitefeather.skygridng.adapters.persistence.TestItemEntity</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
        </properties>
    </persistence-unit>
</persistence>
